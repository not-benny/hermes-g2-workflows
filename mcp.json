{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "workflows": {
      "type": "stdio",
      "command": "python",
      "args": ["-I", "-S", "-B", "${PLUGIN_ROOT}/server.py"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {"PYTHONDONTWRITEBYTECODE": "1"}
    }
  }
}
